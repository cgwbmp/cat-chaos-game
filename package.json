{
  "name": "cat-chaos",
  "private": true,
  "version": "0.1.2-alpha",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=desktop-chrome --project=mobile-chrome --project=mobile-safari",
    "test:perf": "playwright test --project=perf --workers=1",
    "validate-objects": "node --import tsx tools/validate-objects.ts",
    "optimize-glb": "node --import tsx tools/optimize-glb.ts",
    "check-size": "node --import tsx tools/check-bundle-size.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.1",
    "@babylonjs/havok": "1.3.14",
    "@babylonjs/loaders": "9.32.1",
    "meshoptimizer": "1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
